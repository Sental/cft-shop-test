{
    "name": "mage-os/project-community-edition",
    "description": "Community-built eCommerce Platform for Growth",
    "type": "project",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "mage-os/*": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true,
            "opengento/magento2-frankenphp-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require": {
        "cweagans/composer-patches": "^1.7",
        "mage-os/composer-dependency-version-audit-plugin": "4.0.0",
        "mage-os/composer-root-update-plugin": "4.0.0",
        "mage-os/module-worker-mode": "^1.0",
        "mage-os/product-community-edition": "4.0.0",
        "opengento/magento2-frankenphp-base": "^0.9.4",
        "opengento/module-application": "0.11.2"
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "^3.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "dg/bypass-finals": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.22",
        "inchoo/magento-bricklayer": "^1.18",
        "mage-os/magento-coding-standard": "4.0.0",
        "mage-os/magento2-functional-testing-framework": "4.0.0",
        "pdepend/pdepend": "^3@dev",
        "phpmd/phpmd": "^3@dev",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/finder": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/",
            "Magento\\": "app/code/Magento/",
            "MageOS\\Installer\\": "setup/src/MageOS/Installer/"
        },
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/Fixture/**",
            "**/Test/Integration/**",
            "**/Test/Mftf/**",
            "**/Test/Unit/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "MageOS\\Installer\\Test\\": "setup/tests/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "version": "4.0.0",
    "extra": {
        "magento-force": "override",
        "composer-exit-on-patch-failure": true,
        "patches": {
            "opengento/module-application": {
                "Root path / resolves to the frontend, not adminhtml (deploy/patches/README.md)": "patches/composer/opengento_bootstrappool_root_area.diff"
            }
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        }
    ],
    "replace": {
        "magento/magento2-base": "*"
    }
}
